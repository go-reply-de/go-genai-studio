# Baseline workload sizing. Every environment starts from this file, and a
# profile named by the _PROFILE substitution is layered on top (later value
# wins). These are the values every environment ran before per-environment
# sizing existed, so leaving _PROFILE unset changes nothing for anyone.
#
# To add a tunable: add a line here, add the matching ###_KEY### placeholder to
# the manifest, done. No Cloud Build substitution and no Terraform variable is
# needed - the render loop reads this file generically.
#
# _PROFILE may name several profiles, space separated and applied left to right,
# so per-environment overrides layer on a shared set without duplicating it:
#   k8s_profile = "sovereign"            -> default + sovereign
#   k8s_profile = "sovereign sov-prod"   -> default + sovereign + sov-prod

# --- LibreChat API -----------------------------------------------------------
# maxReplicas is capped by storage, not by capacity: the api pod mounts the
# ReadWriteOnce PVC api-images, which attaches to one node at a time. Raising
# this without moving that volume to ReadWriteMany yields pods stuck Pending on
# FailedAttachVolume. See the cost report, finding F1.
API_CPU=10m
API_MEMORY=256Mi
API_MIN_REPLICAS=1
API_MAX_REPLICAS=3

# --- MongoDB: conversations, users, agents -----------------------------------
MONGO_CPU=10m
MONGO_MEMORY=512Mi
MONGO_DISK=10Gi

# --- pgvector: RAG vector store ----------------------------------------------
# PVC expansion is one-way on GKE's default StorageClass: it can grow online but
# never shrink. Raise deliberately.
VECTORDB_CPU=10m
VECTORDB_MEMORY=64Mi
VECTORDB_DISK=100Mi

# --- Meilisearch: conversation search ----------------------------------------
MEILI_CPU=10m
MEILI_MEMORY=1Gi
MEILI_DISK=10Gi

# --- rag_api: ingest and retrieval -------------------------------------------
# --- ingress TLS -------------------------------------------------------------
# Empty: every environment serves TLS from the Google-managed ManagedCertificate
# in k8s/ingress.yaml, and the spec.tls line there is deleted at render time.
# Set this only where a self-managed certificate has actually been published into
# the cluster by terraform - see sovereign.env.
TLS_SECRET_NAME=

# --- api document uploads (LibreChat paths.uploads) ---------------------------
# Matches the other app PVCs. Documents live here; raise it deliberately.
UPLOADS_DISK=10Gi

# One replica, as every environment has always run it.
RAG_REPLICAS=1
RAG_CPU=10m
RAG_MEMORY=512Mi

# --- Moderation & rate limiting ----------------------------------------------
# LibreChat stock defaults, templated so an environment can override them.
# NON_BROWSER_VIOLATION_SCORE equals BAN_INTERVAL, so one non-browser request
# bans immediately - see sovereign.env.
NON_BROWSER_VIOLATION_SCORE=20
LIMIT_MESSAGE_USER=false
MESSAGE_USER_MAX=40
MESSAGE_IP_MAX=40
TRUST_PROXY=1
