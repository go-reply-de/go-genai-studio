# Baseline workload sizing. _PROFILE names profiles layered on top, space
# separated and applied left to right (later wins), e.g.
# "sovereign sov-prod" -> default + sovereign + sov-prod.
#
# To add a tunable: a line here plus a ###_KEY### placeholder in the manifest.
# The render loop is generic - no substitution or Terraform variable needed.

# --- LibreChat API -----------------------------------------------------------
# maxReplicas is capped by storage, not by capacity: the api pod mounts the
# ReadWriteOnce PVC api-images, which attaches to one node at a time. Raising
# this without moving that volume to ReadWriteMany yields pods stuck Pending on
# FailedAttachVolume. See the cost report, finding F1.
API_CPU=10m
API_MEMORY=256Mi
API_MIN_REPLICAS=1
API_MAX_REPLICAS=3

# --- MongoDB: conversations, users, agents -----------------------------------
MONGO_CPU=10m
MONGO_MEMORY=512Mi
MONGO_DISK=10Gi

# --- pgvector: RAG vector store ----------------------------------------------
# PVC expansion is one-way on GKE's default StorageClass: it can grow online but
# never shrink. Raise deliberately.
VECTORDB_CPU=10m
VECTORDB_MEMORY=64Mi
VECTORDB_DISK=100Mi

# --- Meilisearch: conversation search ----------------------------------------
MEILI_CPU=10m
MEILI_MEMORY=1Gi
MEILI_DISK=10Gi

# --- rag_api: ingest and retrieval -------------------------------------------
# --- api document uploads (LibreChat paths.uploads) ---------------------------
# Matches the other app PVCs. Documents live here; raise it deliberately.
UPLOADS_DISK=10Gi

# One replica, as every environment has always run it.
RAG_REPLICAS=1
RAG_CPU=10m
RAG_MEMORY=512Mi

# --- Moderation & rate limiting ----------------------------------------------
# LibreChat stock defaults, templated so an environment can override them.
# NON_BROWSER_VIOLATION_SCORE equals BAN_INTERVAL, so one non-browser request
# bans immediately - see sovereign.env.
NON_BROWSER_VIOLATION_SCORE=20
LIMIT_MESSAGE_USER=false
MESSAGE_USER_MAX=40
MESSAGE_IP_MAX=40
TRUST_PROXY=1
