# Baseline workload sizing. _PROFILE names profiles layered on top, space
# separated and applied left to right (later wins), e.g.
# "sovereign sov-prod" -> default + sovereign + sov-prod.
#
# To add a tunable: a line here plus a ###_KEY### placeholder in the manifest.
# The render loop is generic - no substitution or Terraform variable needed.

# --- LibreChat API -----------------------------------------------------------
# maxReplicas is capped by storage, not by capacity: the api pod mounts the
# ReadWriteOnce PVC api-images, which attaches to one node at a time. Raising
# this without moving that volume to ReadWriteMany yields pods stuck Pending on
# FailedAttachVolume. See the cost report, finding F1.
API_CPU=10m
API_MEMORY=256Mi
API_MIN_REPLICAS=1
API_MAX_REPLICAS=3
# Percentage of API_CPU, so it has to move whenever API_CPU does. Applied only
# where _API_FILES_MODE is rwx - see "Deploy API autoscaler" in cloudbuild.yaml.
API_HPA_TARGET_CPU=80

# --- MongoDB: conversations, users, agents -----------------------------------
MONGO_CPU=10m
MONGO_MEMORY=512Mi
MONGO_DISK=10Gi
# Client-side pool, per api process, so it multiplies by API_MAX_REPLICAS
# against a single mongod. Empty leaves the driver default of 100.
MONGO_MAX_POOL_SIZE=

# --- pgvector: RAG vector store ----------------------------------------------
# PVC expansion is one-way on GKE's default StorageClass: it can grow online but
# never shrink. Raise deliberately.
VECTORDB_CPU=10m
VECTORDB_MEMORY=64Mi
VECTORDB_DISK=100Mi

# --- Meilisearch: conversation search ----------------------------------------
MEILI_CPU=10m
MEILI_MEMORY=1Gi
MEILI_DISK=10Gi

# --- rag_api: ingest and retrieval -------------------------------------------
# --- api document uploads (LibreChat paths.uploads) ---------------------------
# Matches the other app PVCs. Documents live here; raise it deliberately.
UPLOADS_DISK=10Gi

# One replica, as every environment has always run it.
RAG_REPLICAS=1
RAG_CPU=10m
RAG_MEMORY=512Mi

# --- Redis: shared cache, rate-limit counters and resumable stream jobs -------
# Off by default: every environment before the sovereign ones runs one api
# replica with per-process in-memory state. USE_REDIS is read twice - by the api
# pods and by the "Deploy Redis" step in cloudbuild.yaml, which is what applies
# k8s/redis.yaml, so the client and the server cannot drift apart.
# Setting this true with an empty REDIS_URI makes the api container throw at boot.
USE_REDIS=false
USE_REDIS_STREAMS=false
REDIS_URI=
# ioredis stops reconnecting for good once it passes this count, and the default
# of 10 is about one node-maintenance restart. 0 is infinite: a Redis that comes
# back must be picked up again without restarting every api pod.
REDIS_RETRY_MAX_ATTEMPTS=0
REDIS_CPU=500m
REDIS_MEMORY=2Gi
REDIS_MAXMEMORY=1200mb

# --- Availability probe ------------------------------------------------------
# Off by default: environments outside the sovereign projects can use a Cloud
# Monitoring uptime check, which org policy blocks there. PROBE_ENABLED is read
# twice - here for k8s/probe.yaml, and by the "Deploy probe" step in
# cloudbuild.yaml, which is what applies it. Seconds.
PROBE_ENABLED=false
PROBE_INTERVAL=30
PROBE_TIMEOUT=10

# --- Moderation & rate limiting ----------------------------------------------
# LibreChat stock defaults, templated so an environment can override them.
# NON_BROWSER_VIOLATION_SCORE equals BAN_INTERVAL, so one non-browser request
# bans immediately - see sovereign.env.
NON_BROWSER_VIOLATION_SCORE=20
LIMIT_MESSAGE_USER=false
MESSAGE_USER_MAX=40
MESSAGE_IP_MAX=40
TRUST_PROXY=1
# IP-keyed protections. Stock values, templated so an environment whose users
# all share a handful of NAT addresses can turn them off - see sovereign.env.
LIMIT_MESSAGE_IP=true
LOGIN_MAX=20
LOGIN_WINDOW=1
BAN_VIOLATIONS=true

# --- Data retention ----------------------------------------------------------
# Empty keeps LibreChat's rolling window (expiry recomputed on every save).
# A value like "SUN 23:00" switches to a fixed weekly boundary instead.
RETENTION_WEEKLY_RESET=
RETENTION_WEEKLY_RESET_TZ=

# Public environments back up volumes wholesale; unused there, but the
# manifests are shared so it still has to render.
MONGO_DUMP_DISK=1Gi
