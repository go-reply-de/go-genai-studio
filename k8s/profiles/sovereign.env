# Sovereign cloud (uksh sov-dev / sov-prod). Layered over default.env.

# Two minimum: with one, an Autopilot node upgrade is a full outage for every
# clinician at once. Safe above 1 only because Redis below moves stream state
# and the rate-limit counters out of per-pod memory, and because api_files_rwx
# put images/uploads on ReadWriteMany GCS FUSE instead of a single-attach disk.
API_MIN_REPLICAS=2
API_MAX_REPLICAS=4
# 50, not the default 80: that is a percentage of API_CPU, and at 2 CPU an 80%
# target is 1.6 cores. One Node process tops out near a single core of JS, so it
# would never reach the threshold and the deployment would never scale past min.
API_HPA_TARGET_CPU=50

# A scheduling floor, not a cap: Autopilot 1.35 leaves cpu and memory limits
# unset when a container declares none (verified on the live sov-dev pod), so
# the container is Burstable and may exceed both. Memory is the half that
# matters - the node these landed on sits at 99% of memory requests, and a pod
# over its own request is the first thing node-pressure eviction takes. Raising
# CPU mostly buys GC and the libuv threadpool: the api is one Node process, so
# roughly one core of JS is the per-pod ceiling regardless.
API_CPU=2
API_MEMORY=4Gi

# WiredTiger sizes its cache from available memory; 512Mi gave it almost none.
MONGO_CPU=2
MONGO_MEMORY=4Gi
MONGO_DISK=100Gi
# The driver default of 100 per api process is 400 connections into a single
# un-replicated mongod at API_MAX_REPLICAS. 50 is ample for this request rate.
MONGO_MAX_POOL_SIZE=50

# Empty PostgreSQL is already ~40MB, before any vectors.
VECTORDB_CPU=1
VECTORDB_MEMORY=4Gi
VECTORDB_DISK=100Gi

# Single replica by necessity - the open-source build has no clustering.
MEILI_CPU=500m
MEILI_MEMORY=2Gi
MEILI_DISK=20Gi

# Expansion is one-way, so start with room.
UPLOADS_DISK=50Gi

# rag is stateless, so a second replica is free redundancy.
RAG_REPLICAS=2
RAG_CPU=1
RAG_MEMORY=2Gi

# --- Redis -------------------------------------------------------------------
# What allows API_MIN_REPLICAS above 1. v0.8.7 keeps resumable stream jobs in a
# shared store when USE_REDIS_STREAMS is on, so a reconnect landing on another
# pod - or a rolling restart - no longer kills the answer mid-sentence. It also
# makes the bans, login limits and CONCURRENT_MESSAGE_MAX global instead of
# per-pod, which would otherwise multiply by the replica count.
#
# Holds generated answer text while it streams, so it is patient data:
# k8s/redis.yaml runs with persistence off and carries no Backup label.
USE_REDIS=true
USE_REDIS_STREAMS=true
REDIS_URI=redis://redis-service:6379

# --- Availability probe ------------------------------------------------------
# The uptime check cannot exist here (enable_uptime_check = false), so this is
# the only thing that answers "is the app up". It probes api-service directly,
# so it reports on LibreChat rather than on IAP's login redirect.
PROBE_ENABLED=true

# --- Moderation & rate limiting ----------------------------------------------
# Measured 31.08.2026: behind the GCE ingress, req.ip resolved to the load
# balancer, so IP limits and bans went global - one user crossing BAN_INTERVAL
# locked out everyone. TRUST_PROXY=2 fixes req.ip; LIMIT_MESSAGE_USER keys on
# user id and holds even if it is wrong. NOTE this value is hop-count specific:
# the regional Gateway is NEG based and needs a different one.
# NON_BROWSER must stay below BAN_INTERVAL (20), or one request bans.
NON_BROWSER_VIOLATION_SCORE=5
LIMIT_MESSAGE_USER=true
MESSAGE_IP_MAX=2000
TRUST_PROXY=2

# req.ip is a building here, not a person: IAP authenticates every request
# before it reaches the app, and clinicians egress through a handful of hospital
# NAT addresses. So the IP-keyed protections below guard nothing and take out
# everyone behind one gateway. The user-keyed ones above do the real work, and
# Redis makes them global across replicas.
#
# LIMIT_MESSAGE_IP: 2000/min was one shared bucket for the whole hospital -
# 400 clinicians at 5 messages/min sit exactly on it.
LIMIT_MESSAGE_IP=false
# loginLimiter guards the entire OAuth router, so this gates Google sign-in.
# At a shift change hundreds of logins arrive on one NAT address within a
# minute; 20 locked the site. A backstop now, not a control - IAP is the
# perimeter.
LOGIN_MAX=500
LOGIN_WINDOW=1
# banViolation.js sets a ban under req.ip as well as the user id, so one
# clinician crossing BAN_INTERVAL took out everyone sharing their egress -
# measured 31.08.2026. Rate limits and violation logging still apply; users get
# a 429 and retry instead of a two-hour lockout.
BAN_VIOLATIONS=false

# --- Data retention ----------------------------------------------------------
# Patient data may not outlive seven days, and the rolling window never expires
# a conversation somebody keeps reopening. A fixed boundary deletes the whole
# week at once, so Monday starts empty. Berlin local time, so it holds across
# both DST changes - GKE Backup's own schedule is UTC-only and cannot.
RETENTION_WEEKLY_RESET=SUN 23:00
RETENTION_WEEKLY_RESET_TZ=Europe/Berlin

# Export target for Backup for GKE. Sized for the non-patient slice only.
MONGO_DUMP_DISK=5Gi
