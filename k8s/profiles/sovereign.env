# Sovereign cloud (uksh sov-dev / sov-prod). Layered over default.env.

# One replica: stream state is per-pod and in-memory, so a second pod generates
# the answer but cannot stream it. Needs Redis before raising.
API_MIN_REPLICAS=1
API_MAX_REPLICAS=1

# Measured 441Mi against the 256Mi default request. Single replica, so an
# OOMKill is a full outage.
API_CPU=1000m
API_MEMORY=2Gi

# WiredTiger sizes its cache from available memory; 512Mi gave it almost none.
MONGO_CPU=1
MONGO_MEMORY=4Gi
MONGO_DISK=100Gi

# Empty PostgreSQL is already ~40MB, before any vectors.
VECTORDB_CPU=1
VECTORDB_MEMORY=4Gi
VECTORDB_DISK=100Gi

# Single replica by necessity - the open-source build has no clustering.
MEILI_CPU=500m
MEILI_MEMORY=2Gi
MEILI_DISK=20Gi

# --- ingress TLS -------------------------------------------------------------
# UKSH cert published by terraform (modules/iap/tls.tf), attached ALONGSIDE the
# ManagedCertificate: that one cannot exist before DNS moves here, and not at
# all for a regional LB. Keep commented until deploy_self_managed_tls is applied
# or the Ingress references a missing Secret. ###ENVIRONMENT### is resolved by a
# later pass - do not reorder cloudbuild.
# TLS_SECRET_NAME=genai-studio-tls-###ENVIRONMENT###

# Expansion is one-way, so start with room.
UPLOADS_DISK=50Gi

# rag is stateless, so a second replica is free redundancy.
RAG_REPLICAS=2
RAG_CPU=1
RAG_MEMORY=2Gi

# --- Moderation & rate limiting ----------------------------------------------
# Measured 31.08.2026: behind the GCE ingress express resolved req.ip to the
# load balancer, not the client, making the IP limit and IP bans global - one
# user crossing BAN_INTERVAL locked out everyone. TRUST_PROXY=2 fixes req.ip;
# LIMIT_MESSAGE_USER keys on user id and holds even if that is wrong.
# NON_BROWSER must stay below BAN_INTERVAL (20), or one non-browser request bans.
NON_BROWSER_VIOLATION_SCORE=5
LIMIT_MESSAGE_USER=true
MESSAGE_IP_MAX=2000
TRUST_PROXY=2
